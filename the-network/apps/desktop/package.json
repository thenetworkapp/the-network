{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "description": "The Network — production management for sports broadcasting teams",
  "author": {
    "name": "The Network"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "pnpm build && electron-builder",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@network/core": "workspace:*",
    "@network/ui": "workspace:*",
    "@tanstack/react-query": "^5.56.2",
    "chokidar": "^5.0.0",
    "motion": "^11.5.4"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "31.7.3",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  },
  "build": {
    "appId": "app.thenetwork.desktop",
    "productName": "The Network",
    "copyright": "Copyright © 2026 The Network",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "squirrel",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "squirrelWindows": {
      "iconUrl": "https://github.com/thenetworkapp/the-network/raw/main/apps/desktop/resources/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "thenetworkapp",
      "repo": "the-network"
    }
  }
}
