# Copy this file to .env.local and fill in your values.
# These are used at BUILD TIME by Vite — if you change them, rebuild the app.
# NEVER commit .env.local — it is in .gitignore.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: supabase.com → your project → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
# Store the PRIVATE key as a Supabase secret:
#   supabase secrets set VAPID_PRIVATE_KEY=<private-key>
#   supabase secrets set VAPID_PUBLIC_KEY=<public-key>
#   supabase secrets set VAPID_SUBJECT=mailto:you@yourdomain.com
# Paste only the PUBLIC key here:
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here
