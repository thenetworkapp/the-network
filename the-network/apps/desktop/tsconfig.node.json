{
  "extends": "../../tsconfig.base.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "noEmit": false,
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "out",
    "allowImportingTsExtensions": false
  }
}
