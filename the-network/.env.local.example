# Copy this file to .env.local and fill in your Supabase project details.
# NEVER commit .env.local — it is in .gitignore.

# ── Option A: Local development ──────────────────────────────────────────────
# Run `supabase start` then copy the values from the CLI output.
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=<local anon key from supabase start output>

# ── Option B: Cloud (production / shared across devices) ─────────────────────
# 1. Create a project at https://supabase.com/dashboard
# 2. Go to Project Settings → API
# 3. Copy "Project URL" and "anon public" key below
# 4. Run migrations: paste all 9 files from supabase/migrations/ into the SQL editor
#    (or: supabase db push --db-url <your-connection-string>)
# 5. Run seed: paste supabase/seed.sql into the SQL editor
# 6. Go to Authentication → URL Configuration → add your app URL to "Redirect URLs"
# 7. Deploy Edge Functions:
#      supabase functions deploy bootstrap-admin --project-ref <ref>
#      supabase functions deploy invite-user --project-ref <ref>

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Web Push (VAPID) — generate once with: npx web-push generate-vapid-keys
# Add the PRIVATE key as a secret in Supabase: supabase secrets set VAPID_PRIVATE_KEY=...
# Paste the PUBLIC key here:
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# Only needed for local Supabase CLI usage:
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
